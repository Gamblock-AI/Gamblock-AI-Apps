# Gamblock-AI Flutter Client — Environment Configuration
# Copy to `.env` and adjust. This file holds configuration (not secrets) and is
# bundled into the app; do NOT put real secrets here — client-side env is not
# truly private.

# Backend API base URL.
# - Android emulator: http://10.0.2.2:8080  (10.0.2.2 maps to host loopback)
# - Windows / physical device on LAN: http://localhost:8080 or http://<host-ip>:8080
APP_ENV=development

# Backend API base URL.
API_BASE_URL=http://10.0.2.2:8080

# Public Next.js dashboard used for recovery and education hand-offs.
WEB_BASE_URL=https://gamblock-ai.com

